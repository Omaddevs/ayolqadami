# Domenlar (DNS: ikkala A yozuvi ham VPS IP manziliga yo'naltirilgan bo'lishi kerak)
WEB_DOMAIN=ayolqadami.uz
API_DOMAIN=api.ayolqadami.uz
# Sayt qo'shimcha manzilda ham ochilsa (vergul bilan), masalan Vercel: https://ayolqadami.vercel.app
EXTRA_WEB_ORIGINS=https://ayolqadami.vercel.app
# Kirish botidagi «Saytga o'tish» tugmalari manzili (sukut: https://WEB_DOMAIN). Sayt Vercel'da bo'lsa: https://ayolqadami.vercel.app
WEB_URL=

# Let's Encrypt ogohlantirishlari uchun
ACME_EMAIL=

# Baza paroli — kuchli tasodifiy: openssl rand -base64 24
POSTGRES_PASSWORD=

# Google OAuth Client ID (web ilova va server bir xil ID'dan foydalanadi). Bo'sh — Google kirish o'chiq
GOOGLE_CLIENT_ID=

# Google Analytics 4 o'lchov ID'si (G-XXXXXXXXXX). Bo'sh — analitika o'chiq
GA_ID=

# Ixtiyoriy: ayolqadam-bot REST API manzili (https://...), bo'sh qoldirish mumkin
BOT_API_ORIGIN=
