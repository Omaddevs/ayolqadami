# --- Ma'lumotlar bazasi ---
# docker compose up -d db  → lokal PostgreSQL 127.0.0.1:5440 portida
DATABASE_URL="postgresql://ayolqadami:ayolqadami@127.0.0.1:5440/ayolqadami?schema=public"

# --- Xavfsizlik ---
# Kamida 32 belgili tasodifiy satr. Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Web ilova (Vite) manzillari — CORS uchun, vergul bilan. Masalan: https://ayolqadami.uz,https://www.ayolqadami.uz
WEB_ORIGINS="http://localhost:5173,http://localhost:5555"

# Google OAuth Client ID — web ilovadagi VITE_GOOGLE_CLIENT_ID bilan bir xil. Token aynan shu client'ga berilganini server tekshiradi.
# Bo'sh bo'lsa Google orqali kirish o'chiq. Bir nechta bo'lsa vergul bilan.
GOOGLE_CLIENT_ID=""

# Ish beruvchi joylagan vakansiya avval moderatsiyadan o'tadimi (true/false). Admin paneldagi Sozlamalardan ham o'zgartiriladi.
JOB_MODERATION="true"

# --- Birinchi administrator (npm run db:seed yoki npm run admin:create) ---
ADMIN_PHONE="998900000000"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"

# --- Telegram bot (ixtiyoriy) ---
# Odatda admin panel → Telegram → Bot sozlamalari orqali ulanadi. Bu yerda berilsa — panelda o'zgartirib bo'lmaydi.
TELEGRAM_BOT_TOKEN=""
# Bir nechta server nusxasi ishlasa, faqat bittasida polling yoqilsin (qolganlarida "false")
TELEGRAM_POLLING="true"

# --- Kirish boti (telefon raqamini tasdiqlash, SMS o'rniga) ---
# @BotFather'dan olingan alohida bot tokeni. Berilmasa — ro'yxatdan o'tish ishlamaydi (admin panelda tasdiqlashni o'chirmaguncha)
TELEGRAM_LOGIN_BOT_TOKEN=""
# Botni shu server tinglaydimi (sukut: faqat production). Bitta tokenni ikki server tinglasa, kodlar boshqa bazaga tushadi —
# lokalda production tokeni bilan YOQMANG. Kod faqat botdan olinadi, shuning uchun lokalda o'chiq bo'lsa tasdiqlash ishlamaydi.
# Lokalda sinash: @BotFather'da alohida test boti oching, tokenini yuqoriga yozing va bu yerga true qo'ying
LOGIN_BOT_POLLING=""
# Ro'yxatdan o'tishda raqamni tasdiqlash (sukut: true). Admin panel → Sozlamalar'dan ham o'zgartiriladi
PHONE_VERIFICATION="true"
# Bot tugmalaridagi sayt manzili (https). Berilmasa — WEB_ORIGINS dagi birinchi https manzil
WEB_URL=""

# --- ayolqadam-bot statistikasi (ixtiyoriy) ---
# Botning REST API manzili va uning .env'idagi WEB_API_KEY. Berilsa — dashboard'da "Telegram bot" bloki chiqadi.
BOT_API_URL=""
BOT_API_KEY=""
