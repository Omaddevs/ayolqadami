# AyolQadami — production. Caddy Let's Encrypt sertifikatini avtomatik oladi va yangilaydi.
# Domenlar deploy/.env dan: WEB_DOMAIN (sayt), API_DOMAIN (API + admin panel).
{
	email {$ACME_EMAIL}
}

www.{$WEB_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}

{$WEB_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		# frame-ancestors: Telegram Mini App web.telegram.org ichida iframe'da ochiladi
		# googletagmanager / google-analytics — Google Analytics (VITE_GA_ID berilganda)
		Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org https://accounts.google.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://{$API_DOMAIN} https://www.googleapis.com https://accounts.google.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com {$BOT_API_ORIGIN}; frame-src https://accounts.google.com; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# Admin panel API domenida (Next.js): ayolqadami.uz/admin → api.ayolqadami.uz/admin (aks holda sayt 404 ko'rsatadi)
	@admin path /admin /admin/*
	redir @admin https://{$API_DOMAIN}{uri} 302

	# Dinamik sitemap (faol vakansiyalar, kompaniyalar, maqolalar) — serverdan
	handle /sitemap.xml {
		reverse_proxy server:3000
	}

	handle {
		root * /srv
		# Vite fayl nomlarida xesh bor — abadiy keshlanadi; index.html har doim yangilanadi
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# public/ dagi rasmlar (nomida xesh yo'q): 7 kun keshda, keyin fonda yangilanadi
		@images {
			path *.webp *.png *.jpg *.jpeg *.svg *.ico
			not path /assets/*
		}
		header @images Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
		@html path / /index.html
		header @html Cache-Control "no-cache"

		# SPA: mavjud bo'lmagan yo'llar index.html'ga (yo'q /assets/* fayllari 404 qaytaradi)
		@spa {
			not path /assets/*
			not file
		}
		rewrite @spa /index.html
		file_server
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	header -Server
	reverse_proxy server:3000
}
