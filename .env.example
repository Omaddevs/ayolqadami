# Google orqali kirish uchun OAuth Client ID (Google Cloud Console → APIs & Services → Credentials).
# Shu faylni .env.local nomi bilan nusxalab, qiymatni kiriting va dev serverni qayta ishga tushiring.
# "Authorized JavaScript origins" ro'yxatiga http://localhost:5555 (va boshqa manzillaringiz) qo'shilgan bo'lishi kerak.
VITE_GOOGLE_CLIENT_ID=

# Telegram bot (ayolqadam-bot) REST API manzili, masalan https://api.ayolqadami.uz
# Berilsa: bot e'lonlari saytda ko'rinadi, saytda joylangan vakansiya botga (moderatsiyaga) yuboriladi.
VITE_BOT_API_URL=

# AyolQadami backend (server/ papkasi) manzili, masalan https://api.ayolqadami.uz
# Berilsa: hisoblar, vakansiyalar, arizalar, kurslar va murojaatlar serverda saqlanadi va admin paneldan boshqariladi.
# Berilmasa: ilova oflayn demo rejimida (localStorage) ishlaydi.
VITE_API_URL=

# Saytning asosiy manzili (canonical teglar, sitemap, Google uchun). Masalan https://ayolqadami.uz
# Vercel'da qo'shimcha: SITE_URL ni ham shu qiymat bilan bering — boshqa manzillar (*.vercel.app) indekslanmaydi.
VITE_SITE_URL=

# Google Analytics 4 o'lchov ID'si (analytics.google.com → Admin → Data streams → Web). Bo'sh — analitika o'chiq
VITE_GA_ID=
